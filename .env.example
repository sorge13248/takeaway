NODE_ENV=development
PORT=3000
DB_PATH=./takeaway.sqlite
DB_AUTO_LOAD_ENTITIES=true
DB_SYNCHRONIZE=true
DB_LOGGING=false
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Auth configuration
# Set AUTH_MOCK_ENABLED=true to allow local development without an external OIDC provider.
# When AUTH_MOCK_ENABLED=false (or in production), the OIDC fields below must be configured.
AUTH_MOCK_ENABLED=true
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:4200/api/auth/callback
OIDC_FRONTEND_REDIRECT_BASE_URL=http://localhost:4200
